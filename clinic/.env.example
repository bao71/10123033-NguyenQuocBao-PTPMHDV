# setup.ps1 creates .env with a random local administration password.
# Never commit .env or put this password into VS Code workspace settings.
MSSQL_SA_PASSWORD=CHANGE_ME_WITH_A_UNIQUE_STRONG_PASSWORD
MSSQL_APP_USER=clinic_app
MSSQL_APP_PASSWORD=CHANGE_ME_WITH_ANOTHER_UNIQUE_STRONG_PASSWORD
MSSQL_PORT=14331
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
APP_SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_64_CHARACTER_HEX_SECRET
APP_ENV=development
APP_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
MAILHOG_PORT=8025
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=clinic@example.local
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=30

# Gmail: run scripts/configure-gmail.ps1 to enter credentials locally.
# It sets smtp.gmail.com, port 587, STARTTLS, and your sender address.
# SMTP_PASSWORD must be Google's App Password, not your Google login password.
