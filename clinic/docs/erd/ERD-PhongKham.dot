graph ERD { graph [rankdir=TB,bgcolor="white",pad=0.25,nodesep=0.25,ranksep=0.70,splines=polyline,overlap=false,fontname="Arial",fontsize=16,label="ERD HỆ THỐNG QUẢN LÝ PHÒNG KHÁM",labelloc=t]; node [shape=plain,fontname="Arial"]; edge [color="#718096",fontname="Arial",fontsize=8,labeldistance=1.4,labelangle=25]; subgraph cluster_identity { label="Tài khoản và phân quyền"; color="#CBD5E1"; style="rounded"; bgcolor="#FBFCFD"; roles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#718096" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#E8EEF8"><B>ROLES</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">PK role_id</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">UQ code</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">name</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">description</FONT></TD></TR></TABLE>>];
