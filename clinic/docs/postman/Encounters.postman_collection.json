  "item": [
    {
      "name": "Danh sách bệnh án",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/encounters?page=1&page_size=20&sort_order=desc",
        "description": "Dùng token Bác sĩ được giao; bắt đầu từ lịch đã check-in. Bệnh nhân chỉ GET bệnh án hoàn tất. Các request hủy/xóa là nhánh riêng trước hoàn tất."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              " const body = pm.response.json();",
              " if (body.encounter_id) { pm.collectionVariables.set(\"encounter_id\", body.encounter_id); pm.collectionVariables.set(\"encounter_version\", body.version); }",
              " else if (body.appointment_id && body.version) pm.collectionVariables.set(\"appointment_version\", body.version);",
              " if (body.clinical_orders && body.clinical_orders.length) {",
              "  let order = body.clinical_orders.find(o => o.order_id === pm.collectionVariables.get(\"order_id\"));",
              "  if (!order) order = body.clinical_orders[body.clinical_orders.length - 1];",
              "  pm.collectionVariables.set(\"order_id\", order.order_id); pm.collectionVariables.set(\"order_version\", order.version);",
              "  if (order.results.length) { let result = order.results.find(r => r.result_id === pm.collectionVariables.get(\"result_id\")) || order.results[order.results.length - 1]; pm.collectionVariables.set(\"result_id\", result.result_id); pm.collectionVariables.set(\"result_version\", result.version); }",
              " }",
              "}",
              "pm.test(\"Request thành công\", () => pm.expect(pm.response.code).to.be.within(200,299));"
            ]
          }
        }
      ]
    },
